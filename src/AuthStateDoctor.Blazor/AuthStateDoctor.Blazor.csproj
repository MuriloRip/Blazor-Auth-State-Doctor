<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <PackageId>AuthStateDoctor.Blazor</PackageId>
    <Version>0.2.0-preview.1</Version>
    <Description>Opt-in Blazor authentication-state probe for local diagnostics and test environments.</Description>
    <PackageTags>blazor;authentication;diagnostics;testing</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/MuriloRip/Blazor-Auth-State-Doctor</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <None Update="README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
